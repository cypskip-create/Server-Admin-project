# Render @DOMAIN@ before installing at /etc/apache2/sites-available/campusflow.conf.
# Keep all four virtual hosts in this CampusFlow-owned file; do not disable other sites.
SSLProtocol -all +TLSv1.2 +TLSv1.3

<Directory /var/www/campusflow/public>
    Options -Indexes
    AllowOverride None
    Require all granted
</Directory>

<VirtualHost *:80>
    ServerName @DOMAIN@
    Redirect permanent / https://@DOMAIN@/
</VirtualHost>
<VirtualHost *:80>
    ServerName www.@DOMAIN@
    Redirect permanent / https://@DOMAIN@/
</VirtualHost>
<VirtualHost *:80>
    ServerName students.@DOMAIN@
    Redirect permanent / https://students.@DOMAIN@/
</VirtualHost>
<VirtualHost *:80>
    ServerName admin.@DOMAIN@
    Redirect permanent / https://admin.@DOMAIN@/
</VirtualHost>

<VirtualHost *:443>
    ServerName @DOMAIN@
    DocumentRoot /var/www/campusflow/public
    SSLEngine on
    SSLCertificateFile /etc/ssl/certs/campusflow-fullchain.pem
    SSLCertificateKeyFile /etc/ssl/private/campusflow-key.pem
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000"
    ErrorLog ${APACHE_LOG_DIR}/campusflow-main-error.log
    CustomLog ${APACHE_LOG_DIR}/campusflow-main-access.log combined
</VirtualHost>
<VirtualHost *:443>
    ServerName www.@DOMAIN@
    Redirect permanent / https://@DOMAIN@/
    SSLEngine on
    SSLCertificateFile /etc/ssl/certs/campusflow-fullchain.pem
    SSLCertificateKeyFile /etc/ssl/private/campusflow-key.pem
    Header always set Strict-Transport-Security "max-age=31536000"
</VirtualHost>
<VirtualHost *:443>
    ServerName students.@DOMAIN@
    DocumentRoot /var/www/campusflow/public
    SSLEngine on
    SSLCertificateFile /etc/ssl/certs/campusflow-fullchain.pem
    SSLCertificateKeyFile /etc/ssl/private/campusflow-key.pem
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000"
    ErrorLog ${APACHE_LOG_DIR}/campusflow-students-error.log
    CustomLog ${APACHE_LOG_DIR}/campusflow-students-access.log combined
</VirtualHost>
<VirtualHost *:443>
    ServerName admin.@DOMAIN@
    DocumentRoot /var/www/campusflow/public
    SSLEngine on
    SSLCertificateFile /etc/ssl/certs/campusflow-fullchain.pem
    SSLCertificateKeyFile /etc/ssl/private/campusflow-key.pem
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000"
    ErrorLog ${APACHE_LOG_DIR}/campusflow-admin-error.log
    CustomLog ${APACHE_LOG_DIR}/campusflow-admin-access.log combined
</VirtualHost>
